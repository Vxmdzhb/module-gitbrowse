{
    "name": "astrx/module-gitbrowse",
    "description": "Link-through page to a standalone gitweb instance",
    "type": "astrx-module",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered",
        "astrx-module"
    ],
    "homepage": "https://github.com/Vxmdzhb/module-gitbrowse",
    "require": {
        "php": ">=8.4",
        "astrx/cms": "self.version",
        "astrx/framework": "self.version",
        "astrx/library": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AstrX\\GitBrowse\\": ""
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/cms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/framework"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/library"
        }
    ]
}
